{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "project-memory/note.schema.json",
  "title": "Project Memory Note",
  "description": "Frontmatter schema for a Project Memory note (Markdown + YAML). Mirrors src/model.ts. Deterministic core: the runtime validator (validateNote) is authoritative; this file is the declarative contract for tooling and extension-side checks.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "id",
    "project_id",
    "type",
    "status",
    "fingerprint",
    "title",
    "summary",
    "rationale",
    "authority",
    "source_refs",
    "relations",
    "trigger",
    "no_trigger_reason",
    "next_action",
    "status_reason",
    "acceptance_evidence",
    "created_by",
    "created_at",
    "updated_at",
    "promotion"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^PM-(DEF|DEC|QUE|ASM|RSK|IDE)-\\d{4,}$" },
    "project_id": { "type": "string", "minLength": 1 },
    "type": { "enum": ["deferred_work", "decision", "open_question", "assumption", "risk", "idea"] },
    "status": { "type": "string", "minLength": 1 },
    "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "rationale": { "type": "string", "minLength": 1 },
    "priority": { "enum": ["P0", "P1", "P2", "P3"] },
    "authority": {
      "const": "memory",
      "description": "Notes stored in .project-memory always carry authority 'memory' (§7.2); canonical/source truth lives only in canonical sources."
    },
    "confidence": { "enum": ["explicit_discussion", "inferred", "unverified"] },
    "sensitivity": { "enum": ["internal", "public", "restricted"] },
    "tags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "ref"],
        "properties": {
          "kind": { "enum": ["conversation", "event", "file", "commit", "issue", "manual", "other"] },
          "ref": { "type": "string", "minLength": 1 },
          "turn_id": { "type": "string" },
          "observed_at": { "type": "string" },
          "excerpt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "related_files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "relation"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "relation": { "type": "string", "minLength": 1 }
        }
      }
    },
    "relations": {
      "type": "object",
      "properties": {
        "depends_on": { "type": "array", "items": { "type": "string" } },
        "related_to": { "type": "array", "items": { "type": "string" } },
        "supersedes": { "type": "array", "items": { "type": "string" } },
        "superseded_by": { "type": "array", "items": { "type": "string" } },
        "derived_from": { "type": "array", "items": { "type": "string" } },
        "promoted_to": { "type": "array", "items": { "type": "string" } }
      }
    },
    "trigger": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["conditions"],
          "properties": {
            "mode": { "enum": ["all", "any"] },
            "conditions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "required": ["kind", "key", "value"],
                    "properties": {
                      "kind": { "const": "milestone" },
                      "key": { "type": "string", "minLength": 1 },
                      "operator": { "enum": ["equals", "not_equals", "in"] },
                      "value": {
                        "oneOf": [
                          { "type": "string", "minLength": 1 },
                          { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
                        ]
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": ["kind", "key", "value"],
                    "properties": {
                      "kind": { "const": "dependency" },
                      "key": { "type": "string", "minLength": 1 },
                      "operator": { "enum": ["status_in", "status_equals"] },
                      "value": {
                        "oneOf": [
                          { "type": "string", "minLength": 1 },
                          { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
                        ]
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "no_trigger_reason": { "type": ["string", "null"] },
    "next_action": { "type": "string", "minLength": 1 },
    "status_reason": { "type": ["string", "null"] },
    "acceptance_evidence": { "type": ["string", "null"] },
    "created_by": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["agent", "human", "tool"] },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "promotion": {
      "type": "object",
      "required": ["status", "target", "promotion_id", "promoted_at", "backlink", "backlink_verified"],
      "properties": {
        "status": { "enum": ["not_promoted", "promoting", "promoted"] },
        "target": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["kind", "ref", "path"],
              "properties": {
                "kind": { "type": "string" },
                "ref": { "type": "string" },
                "path": { "type": "string", "minLength": 1 },
                "objectId": { "type": "string" },
                "version": { "type": "string" }
              }
            }
          ]
        },
        "promotion_id": { "type": ["string", "null"] },
        "promoted_at": { "type": ["string", "null"] },
        "backlink": { "enum": ["in_file", "link_file", null] },
        "backlink_verified": { "type": "boolean" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "deferred_work" } } },
      "then": {
        "properties": {
          "status": { "enum": ["deferred", "ready", "in_progress", "done", "dropped", "promoted"] }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "decision" } } },
      "then": {
        "properties": {
          "status": { "enum": ["proposed", "accepted", "rejected", "superseded", "promoted"] }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "open_question" } } },
      "then": {
        "properties": {
          "status": { "enum": ["open", "answered", "closed", "promoted"] }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "assumption" } } },
      "then": {
        "properties": {
          "status": { "enum": ["unvalidated", "supported", "invalidated", "expired", "promoted"] }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "risk" } } },
      "then": {
        "properties": {
          "status": { "enum": ["open", "mitigated", "accepted", "realized", "closed", "promoted"] }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "idea" } } },
      "then": {
        "properties": {
          "status": { "enum": ["captured", "incubating", "rejected", "promoted", "archived"] }
        }
      }
    }
  ]
}